# ── Build Stage ──────────────────────────────────────────────────────────────
FROM node:20-alpine3.19 AS builder

# vips-heif: HEIC Support für iPhone-Fotos
# build-base: gcc/g++/make für native Module (Sharp)
# python3: benötigt von node-gyp
RUN apk add --no-cache \
    vips-dev \
    vips-heif \
    fftw-dev \
    build-base \
    python3 \
    curl

WORKDIR /app
COPY server/package*.json ./

# Sharp gegen System-libvips kompilieren (mit HEIC-Support)
ENV SHARP_IGNORE_GLOBAL_LIBVIPS=false
ENV PYTHON=/usr/bin/python3
RUN npm ci --build-from-source

COPY server/ ./
RUN npm run build

# ── Runtime Stage ─────────────────────────────────────────────────────────────
FROM node:20-alpine3.19

# Nur Runtime-Libs, keine Build-Tools
RUN apk add --no-cache vips vips-heif curl

WORKDIR /app
COPY --from=builder /app/dist        ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY server/package*.json ./

EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=5s --retries=10 --start-period=20s \
  CMD curl -f http://localhost:3000/health || exit 1

CMD ["node", "dist/index.js"]
