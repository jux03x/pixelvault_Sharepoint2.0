# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PixelVault Konfiguration
# Kopiere diese Datei zu .env und passe die Werte an
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── PFLICHT ──────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
JWT_SECRET=bitte-aendern-sehr-langer-zufaelliger-sicherheits-schluessel

# ── APP ──────────────────────────────────────────────
APP_URL=http://localhost:8080
PORT=8080
NODE_ENV=production
MAX_FILE_SIZE=50MB

# Optionaler Zugangscode (auskommentieren zum Aktivieren)
# ACCESS_CODE=

# ── E-MAIL (für Magic Links) ─────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PixelVault <noreply@example.com>

# ── DATENBANK (nicht ändern bei Docker) ──────────────
DB_URL=postgresql://pixelvault:pixelvault@postgres:5432/pixelvault
DB_USER=pixelvault
DB_PASSWORD=pixelvault
DB_NAME=pixelvault

# ── SPEICHER (nicht ändern bei Docker) ───────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=pixelvault
MINIO_SECRET_KEY=pixelvault123
MINIO_BUCKET=images
MINIO_USE_SSL=false
